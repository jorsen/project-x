# PostgreSQL connection string (Neon in production; `npx prisma dev` locally)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random secret used to sign auth session tokens — generate with:
#   openssl rand -base64 32
AUTH_SECRET="change-me"

# Optional: override the seed script's default admin account
# SEED_ADMIN_EMPLOYEE_NUMBER="002"
# SEED_ADMIN_PASSWORD="Pass1234"
# SEED_ADMIN_NAME="Admin"

# Optional: Discord webhook URL — if set, posts an alert whenever a part's
# on-hand stock (Ecomp inventory qty or JSCPH BOH) goes negative, either from
# a manual edit or an Excel import. Create one in Discord: Server Settings →
# Integrations → Webhooks → New Webhook → Copy Webhook URL.
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
